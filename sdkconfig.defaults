# ESP-IDF SDK Configuration Defaults
# Отключаем Wi-Fi и Bluetooth для экономии памяти и освобождения пинов

CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_SYSTEM_WIFI_ENABLED=n
CONFIG_ESP_SYSTEM_BLUETOOTH_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BTDM_CTRL_MODE_LE_ONLY=n
CONFIG_FREERTOS_HZ=1000

# Flash size: 4MB (Waveshare ESP32-C6-LCD-1.47)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITIONS_DEFAULT=y

# Консоль на USB-Serial-JTAG (COM7 на плате Waveshare)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL: используем lv_conf.h (Kconfig пропускаем)
CONFIG_LV_CONF_SKIP=y
